        "dataCategory": "Time",
        "lineageTag": "cea8b05c-049f-470b-bf9b-c431f3d57e38",
        "partitions": [
          {
            "name": "DIM_DATE",
            "mode": "import",
            "queryGroup": "3_Model",
            "source": {
              "expression": [
                "let",
                "    Path = p_ProjectRoot & \"\\input\\DIM_DATE.csv\",",
                "    Source = Csv.Document(File.Contents(Path), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "",
                "    // The file stores dd.MM.yyyy. Parsing with an explicit format and culture, rather than an",
                "    // implicit type change, means the model refreshes identically on any machine locale -",
                "    // otherwise 03.01.2018 reads as 3 January here and 1 March somewhere else.",
                "    Dates = Table.TransformColumns(Headers, {",
                "        {\"Date\", each Date.FromText(Text.Trim(_), [Format=\"dd.MM.yyyy\", Culture=\"en-GB\"]), type date},",
                "        {\"MonthStart\", each Date.FromText(Text.Trim(_), [Format=\"dd.MM.yyyy\", Culture=\"en-GB\"]), type date},",
                "        {\"MonthEnd\", each Date.FromText(Text.Trim(_), [Format=\"dd.MM.yyyy\", Culture=\"en-GB\"]), type date}}),",
                "    Typed = Table.TransformColumnTypes(Dates, {",
                "        {\"DateKey\", Int64.Type},",
                "        {\"Year\", Int64.Type},",
                "        {\"Quarter\", type text},",
                "        {\"QuarterNumber\", Int64.Type},",
                "        {\"YearQuarter\", type text},",
                "        {\"MonthNumber\", Int64.Type},",
                "        {\"MonthName\", type text},",
                "        {\"MonthShort\", type text},",
                "        {\"YearMonth\", type text},",
                "        {\"YearMonthSort\", Int64.Type},",
                "        {\"DayOfMonth\", Int64.Type},",
                "        {\"IsMonthStart\", type logical}}),",
                "",
                "    // Derived, not sourced: the file carries no season columns and these are pure calendar",
                "    // arithmetic. April-August are the Baltic pollen months.",
                "    Season = Table.AddColumn(Typed, \"Season\",",
                "        each if List.Contains({12, 1, 2}, [MonthNumber]) then \"Winter\"",
                "             else if List.Contains({3, 4, 5}, [MonthNumber]) then \"Spring\"",
                "             else if List.Contains({6, 7, 8}, [MonthNumber]) then \"Summer\"",
                "             else \"Autumn\", type text),",
                "    AllergySeason = Table.AddColumn(Season, \"AllergySeason\",",
                "        each if [MonthNumber] >= 3 and [MonthNumber] <= 9 then \"High season\" else \"Low season\", type text)",
                "in",
                "    AllergySeason"
              ],
              "type": "m"
            }
          }
        ]
      },

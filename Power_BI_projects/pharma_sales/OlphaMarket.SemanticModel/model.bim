        "lineageTag": "eb4dc83c-f21c-4e5a-a80d-ec67cbb8cbe0",
        "partitions": [
          {
            "name": "AUX_DQ_CHECKS",
            "mode": "import",
            "queryGroup": "3_Model",
            "source": {
              "expression": [
                "let",
                "    // The \"how the data was cleaned\" evidence, computed live off the model rather than typed",
                "    // in by hand: if a refresh changes a number, this table changes with it.",
                "    RawFacts = Src_Data,",
                "    RawSKU = Src_SKU,",
                "    Rules = AUX_SKU_RESOLUTIONS,",
                "    Product = DIM_PRODUCT,",
                "    Corporation = DIM_CORPORATION,",
                "    Fact = FACT_SALES,",
                "",
                "    DuplicateKeyRows = Table.RowCount(RawSKU) - List.Count(List.Distinct(RawSKU[#\"Product name\"])),",
                "    OrphanFactSKUs = List.Count(List.Difference(List.Distinct(RawFacts[SKU]), Product[SKU])),",
                "    UnsoldSKUs = List.Count(List.Difference(Product[SKU], List.Distinct(RawFacts[SKU]))),",
                "    CollapsedRows = Table.RowCount(RawFacts) - Table.RowCount(Fact),",
                "    SummedRows = Table.RowCount(Table.SelectRows(Fact, each [SourceRows] > 1)),",
                "    NonPositive = Table.RowCount(Table.SelectRows(RawFacts, each [#\"Unit, Packs\"] <= 0 or [#\"Value, EUR\"] <= 0)),",
                "    SourceEUR = Number.Round(List.Sum(RawFacts[#\"Value, EUR\"]), 2),",
                "    ModelEUR = Number.Round(List.Sum(Fact[SalesEUR]), 2),",
                "    SourcePacks = List.Sum(RawFacts[#\"Unit, Packs\"]),",
                "    ModelPacks = List.Sum(Fact[UnitsPacks]),",
                "",
                "    Check = (step as text, name as text, value as any, expected as any) as record =>",
                "        [Step = step, Check = name, Value = Text.From(value), Expected = Text.From(expected),",
                "         Status = if Text.From(value) = Text.From(expected) then \"OK\" else \"REVIEW\"],",
                "",
                "    Rows = {",
                "        Check(\"1 Load\", \"Rows on sheet 'data'\", Table.RowCount(RawFacts), 5964),",
                "        Check(\"1 Load\", \"Rows on sheet 'SKU masterdata'\", Table.RowCount(RawSKU), 115),",
                "        Check(\"1 Load\", \"Distinct periods in the source\", List.Count(List.Distinct(RawFacts[Period])), 72),",
                "        Check(\"1 Load\", \"Source rows with units or value <= 0\", NonPositive, 0),",
                "        Check(\"2 Dedup SKU\", \"Masterdata rows sharing a 'Product name'\", DuplicateKeyRows, 8),",
                "        Check(\"2 Dedup SKU\", \"Resolution rules applied\", Table.RowCount(Rules), 8),",
                "        Check(\"2 Dedup SKU\", \"DIM_PRODUCT rows (unique SKUs)\", Table.RowCount(Product), 107),",
                "        Check(\"2 Dedup SKU\", \"SKUs whose conflict was resolved\", Table.RowCount(Table.SelectRows(Product, each [ResolvedConflict])), 8),",
                "        Check(\"3 Corporations\", \"DIM_CORPORATION rows\", Table.RowCount(Corporation), 27),",
                "        Check(\"4 Dedup facts\", \"Fact rows collapsed to the SKU-month grain\", CollapsedRows, 16),",
                "        Check(\"4 Dedup facts\", \"Fact rows built from more than one source row\", SummedRows, 16),",
                "        Check(\"4 Dedup facts\", \"FACT_SALES rows\", Table.RowCount(Fact), 5948),",
                "        Check(\"5 Join\", \"Fact SKUs missing from DIM_PRODUCT\", OrphanFactSKUs, 0),",
                "        Check(\"5 Join\", \"DIM_PRODUCT SKUs with no sales\", UnsoldSKUs, 0),",
                "        Check(\"6 Totals\", \"Sales EUR - source vs model\", ModelEUR, SourceEUR),",
                "        Check(\"6 Totals\", \"Packs - source vs model\", ModelPacks, SourcePacks),",
                "        Check(\"6 Totals\", \"Months in FACT_SALES\", List.Count(List.Distinct(Fact[DateKey])), 72)},",
                "",
                "    Result = Table.FromRecords(Rows,",
                "        type table [Step = text, Check = text, Value = text, Expected = text, Status = text]),",
                "    Indexed = Table.AddIndexColumn(Result, \"CheckOrder\", 1, 1, Int64.Type)",
                "in",
                "    Indexed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",

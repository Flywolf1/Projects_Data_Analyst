    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "p_ProjectRoot",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ],
        "expression": "\"D:\\Work\\Olpha_PBI\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "d7e14020-bc86-45c8-b2bd-014024bdcdc6",
        "queryGroup": "0_Source"
      },
      {
        "name": "Src_Workbook",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    // The one and only external dependency of this model: the task workbook, untouched.",
          "    // Every path in the model is built from the p_ProjectRoot parameter, so moving the",
          "    // project means changing one value instead of hunting through nine queries.",
          "    Path = p_ProjectRoot & \"\\input\\Task for analytic position 2026.xlsx\",",
          "    Source = Excel.Workbook(File.Contents(Path), null, true)",
          "in",
          "    Source"
        ],
        "kind": "m",
        "lineageTag": "8fad0291-6853-4b64-88ab-d6aa1e71e421",
        "queryGroup": "0_Source"
      },
      {
        "name": "Src_Data",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    // Sheet \"data\" exactly as delivered - 5964 rows, nothing removed, nothing renamed.",
          "    Sheet = Src_Workbook{[Item=\"data\", Kind=\"Sheet\"]}[Data],",
          "    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),",
          "    Typed = Table.TransformColumnTypes(Headers, {",
          "        {\"Unit, Packs\", Int64.Type},",
          "        {\"Value, EUR\", type number},",
          "        {\"Period\", type text},",
          "        {\"SKU\", type text}})",
          "in",
          "    Typed"
        ],
        "kind": "m",
        "lineageTag": "1ec8c10c-027e-4245-aefc-231ce8e56d04",
        "queryGroup": "0_Source"
      },
      {
        "name": "Src_SKU",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    // Sheet \"SKU masterdata\" exactly as delivered - 115 rows, duplicates included.",
          "    Sheet = Src_Workbook{[Item=\"SKU masterdata\", Kind=\"Sheet\"]}[Data],",
          "    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),",
          "    Typed = Table.TransformColumnTypes(Headers, {",
          "        {\"Product group\", type text},",
          "        {\"Drug status\", type text},",
          "        {\"Molecule\", type text},",
          "        {\"Corporation\", type text},",
          "        {\"Brand\", type text},",
          "        {\"Product name\", type text},",
          "        {\"Pharmaceutical Form\", type text},",
          "        {\"Pack Size\", Int64.Type},",
          "        {\"Dosage Form\", type number}})",
          "in",
          "    Typed"
        ],
        "kind": "m",
        "lineageTag": "5becef62-8edf-4041-b49c-f075956dd30f",
        "queryGroup": "0_Source"
      },
      {
        "name": "REF_GENERATIONS",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    // Antihistamine generation reference. This is clinical knowledge that does not exist in the",
          "    // source workbook, so it is kept in its own editable file rather than buried in a formula.",
          "    // It is keyed per SKU, which also resolves the 5 rows whose Molecule is the placeholder",
          "    // \"Antihistamines for systemic use\" (FENKAROL -> Quifenadine, Aviamarin -> Dimenhydrinate,",
          "    // Allergicum -> not an antihistamine at all).",
          "    Path = p_ProjectRoot & \"\\input\\allergy_generation.csv\",",
          "    Source = Csv.Document(File.Contents(Path), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
          "    Typed = Table.TransformColumnTypes(Headers, {",
          "        {\"Product name\", type text},",
          "        {\"Molecule_clean\", type text},",
          "        {\"Generation\", Int64.Type},",
          "        {\"Generation label\", type text},",
          "        {\"INN\", type text},",
          "        {\"ChemicalClass\", type text},",
          "        {\"MainUse\", type text},",
          "        {\"GenerationStrict\", Int64.Type}}),",
          "    // The file is maintained in Excel, whose TRUE/FALSE literals follow the editor's UI language,",
          "    // so accept every spelling instead of trusting one of them.",
          "    Sedating = Table.TransformColumns(Typed, {",
          "        {\"Sedating\", each List.Contains({\"TRUE\", \"ИСТИНА\", \"PATIESS\", \"1\"}, Text.Upper(Text.From(_))), type logical}})",
          "in",
          "    Sedating"
        ],
        "kind": "m",
        "lineageTag": "61da75c8-c872-4632-b71f-4c1be7b3321d",
        "queryGroup": "1_Reference"
      },
      {
        "name": "SKU_CLEAN",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    Source = Src_SKU,",
          "",
          "    // \"Dosage Form\" holds the strength in mg, not a pharmaceutical form. Name it for what it is.",
          "    Renamed = Table.RenameColumns(Source, {{\"Dosage Form\", \"StrengthMg\"}}),",
          "",
          "    // The source value is truncated - \"OTC (bezrecepšu\" has no closing bracket. Normalising it",
          "    // HERE, before anything downstream compares against it, is deliberate: every later rule",
          "    // matches plain \"OTC\"/\"RX\" and can never silently miss a row over a missing bracket.",
          "    DrugStatus = Table.TransformColumns(Renamed, {",
          "        {\"Drug status\", each if Text.StartsWith(Text.Upper(Text.From(_)), \"RX\") then \"RX\" else \"OTC\", type text}}),",
          "",
          "    // ---- duplicate resolution, driven by input\\sku_resolution_rules.csv ----",
          "    // 8 SKUs appear twice in the masterdata (16 rows). Each rule names the SKU, the attribute",
          "    // that conflicts and the value that is kept; every other row of that SKU is dropped.",
          "    // 115 rows -> 107, unique on the join key.",
          "    Rules = AUX_SKU_RESOLUTIONS,",
          "    Deduplicated = Table.SelectRows(DrugStatus, (row) =>",
          "        let",
          "            Applicable = Table.SelectRows(Rules, each [#\"Product name\"] = row[#\"Product name\"])",
          "        in",
          "            Table.RowCount(Applicable) = 0",
          "            or List.AllTrue(List.Transform(Table.ToRecords(Applicable),",
          "                (rule) => Record.Field(row, rule[Attribute]) = rule[KeepValue]))),",
          "",
          "    // Flag the survivors that needed a decision, so a reviewer can see which rows were touched.",
          "    ResolvedFlag = Table.AddColumn(Deduplicated, \"ResolvedConflict\",",
          "        each List.Contains(Rules[#\"Product name\"], [#\"Product name\"]), type logical),",
          "",
          "    // Guard. An unresolved duplicate here would fan the fact table out and inflate sales with",
          "    // no visible error at all - which is exactly what the previous version of this file did.",
          "    Verified =",
          "        if Table.RowCount(ResolvedFlag) <> List.Count(List.Distinct(ResolvedFlag[#\"Product name\"]))",
          "        then error \"SKU_CLEAN is not unique on [Product name] - add the missing rule to input\\sku_resolution_rules.csv\"",
          "        else ResolvedFlag",
          "in",
          "    Verified"
        ],
        "kind": "m",
        "lineageTag": "d0898260-9306-403f-9c08-7966dc85fa09",
        "queryGroup": "2_Staging"
      }

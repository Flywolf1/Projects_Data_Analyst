        "lineageTag": "10a20959-a2f4-464c-991c-3ccae1cb5035",
        "partitions": [
          {
            "name": "AUX_SKU_RESOLUTIONS",
            "mode": "import",
            "queryGroup": "1_Reference",
            "source": {
              "expression": [
                "let",
                "    // Every deliberate deviation from the source masterdata, one row each, with its reason.",
                "    // The dedup in SKU_CLEAN is driven by this file rather than by a hand-written filter, so",
                "    // the rules are auditable, editable, and visible in the report itself.",
                "    Path = p_ProjectRoot & \"\\input\\sku_resolution_rules.csv\",",
                "    Source = Csv.Document(File.Contents(Path), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"Product name\", type text},",
                "        {\"Attribute\", type text},",
                "        {\"KeepValue\", type text},",
                "        {\"Reason\", type text}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },

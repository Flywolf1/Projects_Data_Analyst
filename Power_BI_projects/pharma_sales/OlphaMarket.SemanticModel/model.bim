        "lineageTag": "e73ed43b-061d-4b84-889a-1254e20bc3e4",
        "partitions": [
          {
            "name": "DIM_PRODUCT",
            "mode": "import",
            "queryGroup": "3_Model",
            "source": {
              "expression": [
                "let",
                "    Source = SKU_CLEAN,",
                "",
                "    // ---- 1. enrich with the antihistamine generation reference ----",
                "    JoinGenerations = Table.NestedJoin(Source, {\"Product name\"}, REF_GENERATIONS, {\"Product name\"}, \"Generations\", JoinKind.LeftOuter),",
                "    ExpandGenerations = Table.ExpandTableColumn(JoinGenerations, \"Generations\",",
                "        {\"Molecule_clean\", \"Generation\", \"Generation label\", \"Sedating\", \"INN\", \"ChemicalClass\", \"MainUse\", \"GenerationStrict\"},",
                "        {\"MoleculeClean\", \"Generation\", \"GenerationLabel\", \"Sedating\", \"INN\", \"ChemicalClass\", \"MainUse\", \"GenerationStrict\"}),",
                "",
                "    // Stomach SKUs have no generation. Label them rather than leaving nulls behind: a null",
                "    // renders as \"(Blank)\" in every slicer and legend, and grouping silently drops null keys -",
                "    // which would hide half the market.",
                "    FillMolecule = Table.ReplaceValue(ExpandGenerations,",
                "        each [MoleculeClean], each if [MoleculeClean] = null then [Molecule] else [MoleculeClean],",
                "        Replacer.ReplaceValue, {\"MoleculeClean\"}),",
                "    FillGeneration = Table.ReplaceValue(FillMolecule, null, 0, Replacer.ReplaceValue, {\"Generation\", \"GenerationStrict\"}),",
                "    FillLabel = Table.ReplaceValue(FillGeneration, null, \"Non-antihistamine\", Replacer.ReplaceValue, {\"GenerationLabel\"}),",
                "    FillText = Table.ReplaceValue(FillLabel, null, \"n/a\", Replacer.ReplaceValue, {\"INN\", \"ChemicalClass\", \"MainUse\"}),",
                "    SedatingLabel = Table.AddColumn(FillText, \"SedatingLabel\",",
                "        each if [Sedating] = null then \"n/a\" else if [Sedating] then \"Sedating\" else \"Non-sedating\", type text),",
                "",
                "    Market = Table.AddColumn(SedatingLabel, \"Market\",",
                "        each if [#\"Product group\"] = \"Allergies group\" then \"Allergy\"",
                "             else if [#\"Product group\"] = \"Stomach pain group\" then \"Stomach pain\"",
                "             else [#\"Product group\"], type text),",
                "    // \"Not classified\" (-1) and \"Non-antihistamine\" (0) sort after 1st / 2nd / 3rd gen.",
                "    GenerationSort = Table.AddColumn(Market, \"GenerationSort\",",
                "        each if [Generation] = -1 then 8 else if [Generation] = 0 then 9 else [Generation], Int64.Type),",
                "    PackSizeBand = Table.AddColumn(GenerationSort, \"PackSizeBand\",",
                "        each if [#\"Pack Size\"] <= 1 then \"Single unit\"",
                "             else if [#\"Pack Size\"] <= 10 then \"2-10\"",
                "             else if [#\"Pack Size\"] <= 20 then \"11-20\"",
                "             else if [#\"Pack Size\"] <= 30 then \"21-30\"",
                "             else \"31+\", type text),",
                "",
                "    // ---- 3. keys ----",
                "    JoinCorporation = Table.NestedJoin(PackSizeBand, {\"Corporation\"}, DIM_CORPORATION, {\"Corporation\"}, \"Corp\", JoinKind.LeftOuter),",
                "    ExpandCorporation = Table.ExpandTableColumn(JoinCorporation, \"Corp\",",
                "        {\"CorporationKey\", \"ProducerGroup\"}, {\"CorporationKey\", \"ProducerGroup\"}),",
                "    SortedBySKU = Table.Sort(ExpandCorporation, {{\"Product name\", Order.Ascending}}),",
                "    Keyed = Table.AddIndexColumn(SortedBySKU, \"ProductKey\", 1, 1, Int64.Type),",
                "",
                "    RenamedToModel = Table.RenameColumns(Keyed, {",
                "        {\"Product name\", \"SKU\"},",
                "        {\"Product group\", \"ProductGroup\"},",
                "        {\"Drug status\", \"DrugStatus\"},",
                "        {\"Pharmaceutical Form\", \"PharmaceuticalForm\"},",
                "        {\"Pack Size\", \"PackSize\"}}),",
                "    Final = Table.SelectColumns(RenamedToModel, {",
                "        \"ProductKey\", \"SKU\", \"Brand\", \"Corporation\", \"CorporationKey\", \"ProducerGroup\",",
                "        \"Market\", \"ProductGroup\", \"DrugStatus\", \"PharmaceuticalForm\", ",
                "        \"PackSize\", \"PackSizeBand\", \"StrengthMg\",",
                "        \"Molecule\", \"MoleculeClean\", \"INN\", \"Generation\", \"GenerationLabel\",",
                "        \"GenerationSort\", \"GenerationStrict\", \"SedatingLabel\", \"ChemicalClass\", \"MainUse\",",
                "        \"ResolvedConflict\"}),",
                "",
                "    Verified =",
                "        if Table.RowCount(Final) <> List.Count(List.Distinct(Final[SKU]))",
                "        then error \"DIM_PRODUCT is not unique on [SKU]\"",
                "        else Final",
                "in",
                "    Verified"
              ],
              "type": "m"
            }
          }
        ]
      },

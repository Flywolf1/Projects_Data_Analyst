        "lineageTag": "60623045-e542-4b66-b830-7a249fbf07d6",
        "partitions": [
          {
            "name": "FACT_SALES",
            "mode": "import",
            "queryGroup": "3_Model",
            "source": {
              "expression": [
                "let",
                "    Source = Src_Data,",
                "",
                "    // ---- 1. collapse to one row per SKU x month ----",
                "    // 32 source rows form 16 duplicated (SKU, Period) pairs - Nolpaza N14 and Rennie N24.",
                "    // They are summed BEFORE anything is derived from them: a price taken off half a row is",
                "    // wrong, and the later join would multiply them. 5964 -> 5948 rows, totals unchanged.",
                "    Grouped = Table.Group(Source, {\"SKU\", \"Period\"}, {",
                "        {\"UnitsPacks\", each List.Sum([#\"Unit, Packs\"]), Int64.Type},",
                "        {\"SalesEUR\", each List.Sum([#\"Value, EUR\"]), type number},",
                "        {\"SourceRows\", each Table.RowCount(_), Int64.Type}}),",
                "",
                "    // ---- 2. Period (\"2018 January\") -> a real date, plus the Year / Month columns the task asks for ----",
                "    // Parsed against an explicit month list instead of Date.FromText, so the result cannot",
                "    // depend on the locale of whichever machine runs the refresh.",
                "    MonthNames = {\"January\", \"February\", \"March\", \"April\", \"May\", \"June\",",
                "                  \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"},",
                "    WithYear = Table.AddColumn(Grouped, \"Year\",",
                "        each Number.FromText(Text.BeforeDelimiter([Period], \" \")), Int64.Type),",
                "    WithMonthName = Table.AddColumn(WithYear, \"MonthName\",",
                "        each Text.AfterDelimiter([Period], \" \"), type text),",
                "    WithMonthNumber = Table.AddColumn(WithMonthName, \"MonthNumber\",",
                "        each List.PositionOf(MonthNames, [MonthName]) + 1, Int64.Type),",
                "    WithDate = Table.AddColumn(WithMonthNumber, \"Date\",",
                "        each #date([Year], [MonthNumber], 1), type date),",
                "    WithDateKey = Table.AddColumn(WithDate, \"DateKey\",",
                "        each [Year] * 10000 + [MonthNumber] * 100 + 1, Int64.Type),",
                "",
                "    // ---- 3. attach the product and, through it, the corporation ----",
                "    JoinProduct = Table.NestedJoin(WithDateKey, {\"SKU\"}, DIM_PRODUCT, {\"SKU\"}, \"Product\", JoinKind.LeftOuter),",
                "    ExpandProduct = Table.ExpandTableColumn(JoinProduct, \"Product\",",
                "        {\"ProductKey\", \"CorporationKey\", \"PackSize\"}, {\"ProductKey\", \"CorporationKey\", \"PackSize\"}),",
                "",
                "    // ---- 4. doses = packs x pack size ----",
                "    // The additive denominator behind \"price per dose\". Price itself is NOT stored here: a",
                "    // ratio must be aggregated as SUM(value) / SUM(units), never averaged over rows, so it",
                "    // belongs in DAX.",
                "    WithDoses = Table.AddColumn(ExpandProduct, \"Doses\", each [UnitsPacks] * [PackSize], Int64.Type),",
                "",
                "    Sorted = Table.Sort(WithDoses, {{\"DateKey\", Order.Ascending}, {\"ProductKey\", Order.Ascending}}),",
                "    Keyed = Table.AddIndexColumn(Sorted, \"SalesKey\", 1, 1, Int64.Type),",
                "    Final = Table.SelectColumns(Keyed, {",
                "        \"SalesKey\", \"DateKey\", \"Date\", \"Year\", \"MonthName\", \"ProductKey\", \"CorporationKey\",",
                "        \"UnitsPacks\", \"Doses\", \"SalesEUR\", \"SourceRows\"}),",
                "",
                "    Verified =",
                "        if List.Count(List.Select(Final[ProductKey], each _ = null)) > 0 then",
                "            error \"FACT_SALES has rows whose SKU is missing from DIM_PRODUCT\"",
                "        else if Table.RowCount(Final) <> Table.RowCount(Table.Distinct(Table.SelectColumns(Final, {\"DateKey\", \"ProductKey\"}))) then",
                "            error \"FACT_SALES is not unique on (DateKey, ProductKey) - the grain is broken\"",
                "        else Final",
                "in",
                "    Verified"
              ],
              "type": "m"
            }
          }
        ]
      },

        ],
        "lineageTag": "2d99db79-35b6-4f9b-96e1-3f1574855ef0",
        "partitions": [
          {
            "name": "DIM_CORPORATION",
            "mode": "import",
            "queryGroup": "3_Model",
            "source": {
              "expression": [
                "let",
                "    Source = SKU_CLEAN,",
                "",
                "    // One row per corporation that actually owns a selling SKU. Built from the *cleaned*",
                "    // masterdata, so a corporation dropped by a resolution rule (MagnaPharm, the CEE",
                "    // distributor) never survives as an orphan key with no products behind it. 27 rows.",
                "    Names = Table.Distinct(Table.SelectColumns(Source, {\"Corporation\"})),",
                "    Sorted = Table.Sort(Names, {{\"Corporation\", Order.Ascending}}),",
                "    Keyed = Table.AddIndexColumn(Sorted, \"CorporationKey\", 1, 1, Int64.Type),",
                "",
                "    // Portfolio footprint - descriptive attributes for the competitive-landscape page.",
                "    Footprint = Table.Group(Source, {\"Corporation\"}, {",
                "        {\"SKUCount\", each List.Count(List.Distinct([#\"Product name\"])), Int64.Type},",
                "        {\"BrandCount\", each List.Count(List.Distinct([Brand])), Int64.Type},",
                "        {\"ProductGroups\", each Text.Combine(List.Sort(List.Distinct([#\"Product group\"])), \" + \"), type text}}),",
                "    Joined = Table.NestedJoin(Keyed, {\"Corporation\"}, Footprint, {\"Corporation\"}, \"Footprint\", JoinKind.Inner),",
                "    Expanded = Table.ExpandTableColumn(Joined, \"Footprint\", {\"SKUCount\", \"BrandCount\", \"ProductGroups\"}),",
                "",
                "    Scope = Table.AddColumn(Expanded, \"PortfolioScope\",",
                "        each if Text.Contains([ProductGroups], \" + \") then \"Both markets\" else [ProductGroups], type text),",
                "",
                "    // Olainfarm vs the rest, as a real column rather than a per-visual highlight rule. Used as",
                "    // the legend on the producer charts, so the two brand colours are applied by the theme and",
                "    // stay consistent on every page. \"Olainfarm\" sorts before \"Other producers\", so it always",
                "    // takes the first (light) brand colour.",
                "    Producer = Table.AddColumn(Scope, \"ProducerGroup\",",
                "        each if [Corporation] = \"Olainfarm\" then \"Olainfarm\" else \"Other producers\", type text),",
                "",
                "    Final = Table.SelectColumns(Producer,",
                "        {\"CorporationKey\", \"Corporation\", \"ProducerGroup\", \"SKUCount\", \"BrandCount\",",
                "         \"ProductGroups\", \"PortfolioScope\"})",
                "in",
                "    Final"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
